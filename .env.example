# Supabase → Project Settings → API (Data API)
# "Project URL"
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# "anon public" key (Publishable key). Niemals den service_role / secret key hier eintragen!
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Name des Lokals (wird in der App angezeigt)
NEXT_PUBLIC_CAFE_NAME=Mein Café
